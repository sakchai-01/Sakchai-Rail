# ==========================================
# Northwind Web App Environment Configuration
# ==========================================

# 1. การใช้งานบน Railway (Railway Cloud Platform / PaaS)
# เมื่อสร้าง MySQL Service ใน Railway ระบบจะมีตัวแปรเหล่านี้ให้อัตโนมัติ:
# DATABASE_URL=mysql://root:password@mysql.railway.internal:3306/railway
# หรือตั้งค่าใน Web Service:
# DATABASE_URL=${{MySQL.MYSQL_PRIVATE_URL}}

# 2. การรันบน Local Development (XAMPP / Laragon / Local MySQL)
# สามารถกำหนดค่าแบบแยกตัวแปร หรือใช้ DATABASE_URL ก็ได้:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_northwind
DB_USER=root
DB_PASS=

# หรือรูปแบบ URL:
# DATABASE_URL=mysql://root:@127.0.0.1:3306/db_northwind